// Colour for x in [0, 1]: map 0 is viridis, 1 is inferno
fn colormap(map: u32, x: f32) -> vec3f {
    let t = clamp(x, 0.0, 1.0) * 63.0;
    let i = min(u32(t), 62u);
    let f = t - f32(i);
    if map == 1u {
        return mix(INFERNO[i], INFERNO[i + 1u], f);
    }
    return mix(VIRIDIS[i], VIRIDIS[i + 1u], f);
}
